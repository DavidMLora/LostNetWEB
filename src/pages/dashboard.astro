---
import Layout from '../layouts/Layout.astro';
const PAGE_TITLE = 'LostNet Dashboard';
---

<Layout title={PAGE_TITLE}>
<header class="bg-white border-b border-gray-200 h-16 flex items-center justify-between px-4 shadow-sm z-50 relative">
  <div class="flex items-center gap-3">
    <!-- BOTÓN DE MENÚ IZQUIERDO (Filtros) -->
    <button id="btn-menu-toggle" class="text-gray-600 hover:bg-gray-100 p-2 rounded-lg transition-colors focus:ring-2 focus:ring-blue-500">
      <span class="text-xl font-bold">☰</span>
    </button>
    
    <div class="flex items-center gap-2">
      <div class="bg-blue-600 rounded-lg p-1.5 shadow-sm flex items-center justify-center">
        <img src="/favicon.jpg"
             alt="LostNet Logo"
             class="w-7 h-7 object-cover rounded-full border border-white shadow-sm" />
      </div>
      <h1 class="font-bold text-gray-800 text-lg tracking-tight hidden sm:block">LostNet <span class="text-blue-600">Monitor</span></h1>
    </div>
  </div>

  <div class="flex items-center gap-3">
    
    <!-- ÁREA DE ESTADO Y NOTIFICACIONES -->
    <div class="flex items-center gap-2 bg-gray-50 p-1 pr-3 rounded-full border border-gray-200">
        
        <!-- Botón Notificaciones (Abre Sidebar Derecho) -->
        <button id="btn-notifications-sidebar" class="p-1.5 bg-white text-gray-600 rounded-full hover:bg-gray-100 hover:text-blue-600 transition-colors relative shadow-sm border border-gray-100 focus:outline-none" title="Ver alertas cercanas">
            🔔
            <span id="badge-notifications" class="hidden absolute top-0 right-0 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-white"></span>
        </button>

        <!-- Status Indicator -->
        <div id="status-indicator" class="flex items-center gap-1.5 px-2 text-xs font-medium text-gray-500">
            <span class="w-2 h-2 rounded-full bg-gray-400"></span> 
            <span class="hidden sm:inline">Desconectado</span>
        </div>
    </div>

    <!-- Badge de rol del usuario (MongoDB) -->
    <div class="flex items-center gap-2 bg-gray-50 px-3 py-1.5 rounded-full border border-gray-200">
      <span id="user-role-icon" class="text-sm">👤</span>
      <div class="flex flex-col leading-none">
        <span class="text-[9px] text-gray-400 uppercase font-bold">Rango</span>
        <span id="user-badge" class="text-xs font-bold text-blue-600">...</span>
      </div>
    </div>

    <div class="h-6 w-px bg-gray-300 mx-1"></div>

    <!-- Botón Cerrar Sesión -->
    <button
      id="btn-logout"
      class="text-gray-600 hover:text-red-600 hover:bg-red-50 px-3 py-1.5 rounded-lg transition-colors flex items-center gap-2 text-sm font-semibold"
      title="Cerrar Sesión"
    >
      <i class="fa-solid fa-right-from-bracket"></i>
      <span>Salir</span>
    </button>

  </div>
</header>

<div class="relative w-full h-[calc(100vh-4rem)] overflow-hidden bg-slate-200">
  
  <!-- 1. PANEL LATERAL IZQUIERDO (FILTROS) -->
  <aside id="sidebar-menu" class="absolute top-0 left-0 w-full sm:w-80 h-full bg-white/95 backdrop-blur-sm border-r border-gray-200 flex flex-col z-30 shadow-2xl transition-transform duration-300 ease-in-out -translate-y-full sm:-translate-x-full lg:translate-x-0 lg:translate-y-0 transform">
    
    <div class="p-5 border-b border-gray-100 bg-slate-50/80 shrink-0">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-xs font-bold text-gray-400 uppercase tracking-wider">Explorar & Filtrar</h2>
        <button id="btn-close-menu" class="lg:hidden text-gray-400 hover:text-gray-600">&times;</button>
      </div>
      
      <!-- Buscador -->
      <div class="relative mb-5 group">
        <input type="text" id="search-input" placeholder="Buscar (ej. llaves...)" 
               class="w-full pl-10 pr-4 py-2.5 bg-white border border-gray-300 rounded-xl text-sm shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all group-hover:border-gray-400">
        <span class="absolute left-3.5 top-3 text-gray-400 group-hover:text-gray-600 transition-colors">🔍</span>
      </div>

      <div class="space-y-5">
        <!-- Filtros Rápidos (Chips) -->
        <div class="flex gap-3">
            <label class="flex-1 cursor-pointer select-none">
                <input type="checkbox" id="filter-nearby" class="peer sr-only">
                <div class="w-full py-2 px-2 bg-white border border-gray-200 rounded-lg text-center text-xs font-semibold text-gray-600 shadow-sm transition-all hover:bg-gray-50 peer-checked:bg-red-50 peer-checked:text-red-600 peer-checked:border-red-200 peer-checked:shadow-inner flex flex-col items-center gap-1">
                    <span class="text-lg">📍</span> 
                    <span>Cercanos (2.5km)</span>
                </div>
            </label>
            <label class="flex-1 cursor-pointer select-none">
                <input type="checkbox" id="filter-mine" class="peer sr-only">
                <div class="w-full py-2 px-2 bg-white border border-gray-200 rounded-lg text-center text-xs font-semibold text-gray-600 shadow-sm transition-all hover:bg-gray-50 peer-checked:bg-blue-50 peer-checked:text-blue-600 peer-checked:border-blue-200 peer-checked:shadow-inner flex flex-col items-center gap-1">
                    <span class="text-lg">👤</span> 
                    <span>Mis Reportes</span>
                </div>
            </label>
        </div>

        <!-- Categorías -->
        <div>
            <div class="flex items-center gap-2 mb-2">
                <span class="w-1 h-3 bg-gray-300 rounded-full"></span>
                <h3 class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Categorías</h3>
            </div>
            
            <div class="grid grid-cols-2 gap-y-3 gap-x-4">
                <label class="flex items-center gap-2.5 cursor-pointer group p-1 rounded hover:bg-gray-50 transition-colors">
                    <div class="relative flex items-center justify-center w-5 h-5">
                        <input type="checkbox" value="Electrónica" class="filter-cat peer appearance-none w-5 h-5 border-2 border-gray-300 rounded bg-white checked:bg-indigo-600 checked:border-indigo-600 transition-all cursor-pointer">
                        <svg class="w-3 h-3 text-white absolute opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"></path></svg>
                    </div>
                    <span class="text-sm text-gray-600 group-hover:text-gray-900 select-none flex items-center gap-1.5">📱 Electrónica</span>
                </label>

                <label class="flex items-center gap-2.5 cursor-pointer group p-1 rounded hover:bg-gray-50 transition-colors">
                    <div class="relative flex items-center justify-center w-5 h-5">
                        <input type="checkbox" value="Ropa" class="filter-cat peer appearance-none w-5 h-5 border-2 border-gray-300 rounded bg-white checked:bg-green-600 checked:border-green-600 transition-all cursor-pointer">
                        <svg class="w-3 h-3 text-white absolute opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"></path></svg>
                    </div>
                    <span class="text-sm text-gray-600 group-hover:text-gray-900 select-none flex items-center gap-1.5">👕 Ropa</span>
                </label>

                <label class="flex items-center gap-2.5 cursor-pointer group p-1 rounded hover:bg-gray-50 transition-colors">
                    <div class="relative flex items-center justify-center w-5 h-5">
                        <input type="checkbox" value="Documentos" class="filter-cat peer appearance-none w-5 h-5 border-2 border-gray-300 rounded bg-white checked:bg-orange-500 checked:border-orange-500 transition-all cursor-pointer">
                        <svg class="w-3 h-3 text-white absolute opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"></path></svg>
                    </div>
                    <span class="text-sm text-gray-600 group-hover:text-gray-900 select-none flex items-center gap-1.5">📄 Documentos</span>
                </label>

                <label class="flex items-center gap-2.5 cursor-pointer group p-1 rounded hover:bg-gray-50 transition-colors">
                    <div class="relative flex items-center justify-center w-5 h-5">
                        <input type="checkbox" value="Otros" class="filter-cat peer appearance-none w-5 h-5 border-2 border-gray-300 rounded bg-white checked:bg-gray-600 checked:border-gray-600 transition-all cursor-pointer">
                        <svg class="w-3 h-3 text-white absolute opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"></path></svg>
                    </div>
                    <span class="text-sm text-gray-600 group-hover:text-gray-900 select-none flex items-center gap-1.5">📦 Otros</span>
                </label>
            </div>
        </div>
      </div>
    </div>

    <!-- Lista de Resultados -->
    <div class="flex-1 overflow-y-auto p-2 overscroll-contain custom-scrollbar bg-slate-50/50" id="reports-list-container">
       <div id="reports-list" class="space-y-2 pb-20 p-1"> 
          <p class="text-center text-gray-400 text-xs mt-10">Cargando reportes...</p>
       </div>
    </div>

    <!-- Stats Footer -->
    <div class="p-4 border-t border-gray-100 bg-white shrink-0 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)]">
      <div class="grid grid-cols-2 gap-3 text-center">
        <div class="bg-blue-50 p-2 rounded-lg border border-blue-100">
          <span id="stat-reportes" class="block font-bold text-blue-700 text-xl">--</span>
          <span class="text-[10px] text-blue-600 uppercase font-semibold tracking-wide">Visibles</span>
        </div>
        <div class="bg-green-50 p-2 rounded-lg border border-green-100">
          <span id="stat-seguros" class="block font-bold text-green-700 text-xl">--</span>
          <span class="text-[10px] text-green-600 uppercase font-semibold tracking-wide">Seguros</span>
        </div>
      </div>
    </div>
  </aside>

  <!-- MAPA -->
  <div id="map" class="w-full h-full z-0"></div>

  <!-- 2. PANEL LATERAL DERECHO (NOTIFICACIONES) -->
  <aside id="notifications-menu" class="absolute top-0 right-0 w-full sm:w-80 h-full bg-white/95 backdrop-blur-sm border-l border-gray-200 flex flex-col z-30 shadow-2xl transition-transform duration-300 ease-in-out translate-x-full">
    <!-- Header del Panel -->
    <div class="p-4 border-b border-yellow-100 bg-yellow-50 shrink-0 flex justify-between items-center shadow-sm">
      <div class="flex items-center gap-3">
        <span class="text-2xl bg-white p-1 rounded-full shadow-sm">🔔</span>
        <div>
          <h2 class="text-sm font-bold text-gray-800">Alertas Cercanas</h2>
          <p class="text-[10px] text-gray-500 font-medium">Radio de 2.5km de tu posición</p>
        </div>
      </div>
      <button id="btn-close-notifications" class="text-gray-400 hover:text-gray-600 w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/50 transition-colors text-xl">&times;</button>
    </div>

    <!-- Lista de Notificaciones -->
    <div class="flex-1 overflow-y-auto p-3 custom-scrollbar bg-slate-50/50">
        <div id="notifications-list" class="space-y-3 pb-20">
            <p class="text-center text-gray-400 text-xs py-10">
              Presiona 📍 "Ubicarme" primero<br>para ver reportes cercanos.
            </p>
        </div>
    </div>
  </aside>

  <!-- BOTONES FLOTANTES -->
  <div class="absolute bottom-36 right-4 z-[20] flex flex-col gap-3 items-end pointer-events-none">
    <div class="pointer-events-auto flex flex-col gap-3 items-end">
      <!-- Botón Agregar Reporte -->
      <button id="btn-add-report" class="bg-blue-600 hover:bg-blue-700 text-white w-14 h-14 rounded-full shadow-xl flex items-center justify-center transition-transform active:scale-95 group relative mb-2">
        <span class="text-3xl font-light pb-1">+</span>
        <span class="absolute right-full mr-3 bg-gray-900 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">Reportar Objeto</span>
      </button>
      
      <!-- Botón GPS -->
      <button id="btn-gps" class="bg-white hover:bg-gray-50 text-gray-700 p-3 rounded-full shadow-lg border border-gray-200 transition-transform active:scale-95" title="Ubicarme">
        📍
      </button>
      
      <!-- Botón Refrescar -->
      <button id="btn-refresh" class="bg-white hover:bg-gray-50 text-gray-700 p-3 rounded-full shadow-lg border border-gray-200 transition-transform active:scale-95" title="Actualizar Datos">
        🔄
      </button>
    </div>
  </div>

  <!-- SIMBOLOGÍA -->
  <div class="absolute bottom-6 right-4 bg-white/90 backdrop-blur rounded-lg shadow-lg p-3 z-[400] text-xs border border-gray-100 hidden sm:block">
    <h3 class="font-bold text-gray-600 mb-2">Simbología</h3>
    <div class="flex items-center gap-2 mb-1"><span class="w-3 h-3 rounded-full bg-blue-500 border border-white shadow-sm"></span> Mis Reportes</div>
    <div class="flex items-center gap-2 mb-1"><span class="w-3 h-3 rounded-full bg-red-500 border border-white shadow-sm"></span> Otros Reportes</div>
    <div class="flex items-center gap-2"><div class="w-3 h-3 bg-green-500 rotate-45 border border-white shadow-sm"></div> Zona Segura</div>
  </div>
</div>

<!-- MODAL NUEVO REPORTE -->
<div id="report-modal" class="fixed inset-0 z-[1000] bg-black/50 hidden flex items-center justify-center p-4 backdrop-blur-sm transition-opacity">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-md max-h-[90vh] overflow-y-auto transform transition-all scale-100">
    <div class="bg-blue-600 p-4 flex justify-between items-center sticky top-0 z-10">
      <h3 class="text-white font-bold text-lg">📝 Nuevo Reporte</h3>
      <button id="btn-close-modal" class="text-white/80 hover:text-white text-2xl leading-none">&times;</button>
    </div>
    
    <form id="form-report" class="p-6 space-y-4">
      <div class="space-y-2">
        <label class="block text-sm font-medium text-gray-700">Foto del objeto</label>
        <div class="relative border-2 border-dashed border-gray-300 rounded-lg p-4 text-center hover:bg-gray-50 transition-colors cursor-pointer group" id="dropzone">
          <input type="file" id="input-photo" name="foto" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" required>
          <div id="preview-container" class="hidden">
             <img id="preview-img" class="mx-auto h-32 object-contain rounded" />
             <span class="text-xs text-blue-600 block mt-2">Clic para cambiar</span>
          </div>
          <div id="upload-placeholder">
            <span class="text-2xl">📷</span>
            <p class="text-xs text-gray-500 mt-1 group-hover:text-blue-500">Toca para subir foto</p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div class="col-span-2">
          <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
          <input type="text" name="description" maxlength="30" placeholder="Ej. Llaves Honda..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-sm" required>
        </div>

        <div class="col-span-1">
          <label class="block text-sm font-medium text-gray-700 mb-1">Categoría</label>
          <select name="category" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-sm bg-white" required>
            <option value="Otros">Seleccionar...</option>
            <option value="Electrónica">📱 Electrónica</option>
            <option value="Ropa">👕 Ropa</option>
            <option value="Documentos">📄 Documentos</option>
            <option value="Otros">📦 Otros</option>
          </select>
        </div>
        
        <div class="col-span-1">
          <label class="block text-sm font-medium text-gray-700 mb-1">Teléfono (Opc.)</label>
          <input type="tel" name="phone" placeholder="Ej. 449..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-sm">
        </div>
      </div>

      <!-- SECCIÓN SEGURIDAD -->
      <div class="pt-2 border-t border-gray-100">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-lg">🔒</span>
          <p class="text-xs font-bold text-gray-600 uppercase">Seguridad (Para Reclamar)</p>
        </div>
        
        <div class="bg-gray-50 p-3 rounded-lg space-y-3 border border-gray-200">
            <div>
                <label class="block text-xs font-medium text-gray-500 mb-1">Pregunta secreta</label>
                <input type="text" name="security_question" placeholder="Ej. ¿De qué color es el llavero?" class="w-full px-3 py-2 border border-gray-200 rounded focus:ring-1 focus:ring-blue-500 outline-none text-sm bg-white">
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-500 mb-1">Respuesta correcta</label>
                <input type="text" name="security_answer" placeholder="Ej. Azul marino" class="w-full px-3 py-2 border border-gray-200 rounded focus:ring-1 focus:ring-blue-500 outline-none text-sm bg-white">
            </div>
        </div>
      </div>

      <input type="hidden" name="lat" id="input-lat">
      <input type="hidden" name="lon" id="input-lon">

      <!-- SWITCH YO ENCONTRÉ ESTE OBJETO -->
      <div class="pt-2 border-t border-gray-100">
        <label class="flex items-center justify-between cursor-pointer bg-green-50 hover:bg-green-100 transition-colors p-3 rounded-xl border border-green-200">
          <div class="flex items-center gap-2">
            <span class="text-lg"></span>
            <div>
              <p class="text-sm font-bold text-green-700">¡Yo encontré este objeto!</p>
              <p class="text-[10px] text-green-600">Activa si ya fue recuperado</p>
            </div>
          </div>
          <!-- Toggle switch -->
          <div class="relative">
            <input type="checkbox" id="toggle-found" class="sr-only peer">
            <div class="w-11 h-6 bg-gray-300 peer-checked:bg-green-500 rounded-full transition-colors duration-300 peer-focus:ring-2 peer-focus:ring-green-400"></div>
            <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform duration-300 peer-checked:translate-x-5"></div>
          </div>
        </label>

        <!-- Preview dinámico del estado -->
        <div id="status-preview" class="mt-2 flex items-center gap-2 px-3 py-2 rounded-lg bg-red-50 border border-red-200 transition-all duration-300">
          <span id="status-preview-dot" class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
          <span id="status-preview-text" class="text-xs font-bold text-red-600">PERDIDO — se publicará como objeto extraviado</span>
        </div>
      </div>
      
      <button type="submit" id="btn-submit-report" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg shadow-md transition-transform active:scale-95">
        Publicar Reporte
      </button>
    </form>
  </div>
</div>

<!-- MODAL VISTA DETALLADA -->
<div id="view-modal" class="fixed inset-0 z-[2000] bg-black/50 hidden flex items-center justify-center p-4 backdrop-blur-sm transition-opacity">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-md max-h-[90vh] flex flex-col overflow-hidden relative">
      <div id="view-modal-content" class="overflow-y-auto custom-scrollbar flex-1 pb-4"></div>
      <button id="btn-close-view" class="absolute top-4 right-4 bg-black/30 hover:bg-black/50 text-white rounded-full p-2 backdrop-blur-sm transition-colors z-10 w-8 h-8 flex items-center justify-center">
          ✕
      </button>
  </div>
</div>

<div id="google-login-btn" class="hidden fixed top-4 right-4 z-[1000]"></div>
<div
  id="toast"
  class="fixed bottom-4 left-1/2 -translate-x-1/2 px-4 py-2 rounded-lg shadow-lg text-sm text-white bg-gray-900 hidden z-[3000]"
>
</div>

<script>
  import "../scripts/app.js";
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 8px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: #f8fafc; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 4px; border: 2px solid #f8fafc; }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover { background-color: #94a3b8; }
  .custom-scrollbar { scrollbar-width: thin; scrollbar-color: #cbd5e1 #f8fafc; }
</style>

</Layout>