---
import Layout from '../layouts/Layout.astro';
const PAGE_TITLE = 'LostNet Dashboard';
---

<Layout title={PAGE_TITLE}>
<header class="bg-white border-b border-gray-200 h-16 flex items-center justify-between px-4 shadow-sm z-50 relative">
  <div class="flex items-center gap-3">
    <!-- BOTÓN DE MENÚ (Toggle) -->
    <button id="btn-menu-toggle" class="text-gray-600 hover:bg-gray-100 p-2 rounded-lg transition-colors focus:ring-2 focus:ring-blue-500">
      <span class="text-xl font-bold">☰</span>
    </button>
    
    <div class="flex items-center gap-2">
      <div class="bg-blue-600 text-white p-1.5 rounded-lg text-sm">📡</div>
      <h1 class="font-bold text-gray-800 text-lg tracking-tight hidden sm:block">LostNet <span class="text-blue-600">Monitor</span></h1>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <div id="status-indicator" class="flex items-center gap-2 px-3 py-1 bg-gray-100 rounded-full text-xs font-medium text-gray-500">
      <span class="w-2 h-2 rounded-full bg-gray-400"></span> <span class="hidden sm:inline">Desconectado</span>
    </div>
  </div>
</header>

<div class="relative w-full h-[calc(100vh-4rem)] overflow-hidden bg-slate-200">
  
  <!-- PANEL LATERAL -->
  <aside id="sidebar-menu" class="absolute top-0 left-0 w-full sm:w-80 h-full bg-white/95 backdrop-blur-sm border-r border-gray-200 flex flex-col z-30 shadow-2xl transition-transform duration-300 ease-in-out -translate-y-full">
    
    <!-- Sección de Buscador y Filtros -->
    <div class="p-5 border-b border-gray-100 bg-slate-50/80 shrink-0">
      <div class="flex justify-between items-center mb-3">
        <h2 class="text-xs font-bold text-gray-400 uppercase tracking-wider">Explorar</h2>
        <button id="btn-close-menu" class="sm:hidden text-gray-400 hover:text-gray-600">&times;</button>
      </div>
      
      <div class="space-y-3">
        <!-- Buscador -->
        <div class="relative">
          <input type="text" id="search-input" placeholder="Buscar (ej. perro, llaves...)" 
                 class="w-full pl-9 pr-4 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none transition-all">
          <span class="absolute left-3 top-2.5 text-gray-400">🔍</span>
        </div>

        <!-- Filtro -->
        <select id="category-filter" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none cursor-pointer">
          <option value="all">Todas las categorías</option>
          <option value="Electrónica">📱 Electrónica</option>
          <option value="Ropa">👕 Ropa</option>
          <option value="Documentos">📄 Documentos</option>
          <option value="Otros">📦 Otros</option>
        </select>
      </div>
    </div>

    <!-- Lista de Resultados con Scroll Personalizado -->
    <!-- 
         overscroll-contain: Evita que el scroll afecte a la página padre
         custom-scrollbar: Clase definida abajo en <style>
    -->
    <div class="flex-1 overflow-y-auto p-2 overscroll-contain custom-scrollbar" id="reports-list-container">
       <div id="reports-list" class="space-y-2 pb-20"> 
          <p class="text-center text-gray-400 text-xs mt-10">Cargando reportes...</p>
       </div>
    </div>

    <!-- Stats Footer -->
    <div class="p-4 border-t border-gray-100 bg-white shrink-0">
      <div class="grid grid-cols-2 gap-2 text-center">
        <div class="bg-blue-50 p-2 rounded">
          <span id="stat-reportes" class="block font-bold text-blue-700 text-lg">--</span>
          <span class="text-[10px] text-blue-600 uppercase">Visibles</span>
        </div>
        <div class="bg-green-50 p-2 rounded">
          <span id="stat-seguros" class="block font-bold text-green-700 text-lg">--</span>
          <span class="text-[10px] text-green-600 uppercase">Seguros</span>
        </div>
      </div>
    </div>
  </aside>

  <!-- MAPA (OCUPA TODO EL FONDO) -->
  <div id="map" class="w-full h-full z-0"></div>

  <!-- BOTONES FLOTANTES -->
  <div class="absolute bottom-36 right-4 z-[400] flex flex-col gap-3 items-end">
    <button id="btn-add-report" class="bg-blue-600 hover:bg-blue-700 text-white w-14 h-14 rounded-full shadow-xl flex items-center justify-center transition-transform active:scale-95 group relative">
      <span class="text-3xl font-light pb-1">+</span>
      <span class="absolute right-full mr-3 bg-gray-900 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">Reportar Objeto</span>
    </button>

    <button id="btn-gps" class="bg-white hover:bg-gray-50 text-gray-700 p-3 rounded-full shadow-lg border border-gray-200 transition-transform active:scale-95" title="Ubicarme">
      📍
    </button>
    <button id="btn-refresh" class="bg-white hover:bg-gray-50 text-gray-700 p-3 rounded-full shadow-lg border border-gray-200 transition-transform active:scale-95" title="Actualizar Datos">
      🔄
    </button>
  </div>

  <!-- SIMBOLOGÍA -->
  <div class="absolute bottom-6 right-4 bg-white/90 backdrop-blur rounded-lg shadow-lg p-3 z-[400] text-xs border border-gray-100 hidden sm:block">
    <h3 class="font-bold text-gray-600 mb-2">Simbología</h3>
    <div class="flex items-center gap-2 mb-1"><span class="w-3 h-3 rounded-full bg-blue-500 border border-white shadow-sm"></span> Mis Reportes</div>
    <div class="flex items-center gap-2 mb-1"><span class="w-3 h-3 rounded-full bg-red-500 border border-white shadow-sm"></span> Otros Reportes</div>
    <div class="flex items-center gap-2"><div class="w-3 h-3 bg-green-500 rotate-45 border border-white shadow-sm"></div> Zona Segura</div>
  </div>
</div>

<!-- MODAL NUEVO REPORTE -->
<div id="report-modal" class="fixed inset-0 z-[1000] bg-black/50 hidden flex items-center justify-center p-4 backdrop-blur-sm transition-opacity">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-md overflow-hidden transform transition-all scale-100">
    <div class="bg-blue-600 p-4 flex justify-between items-center">
      <h3 class="text-white font-bold text-lg">📝 Nuevo Reporte</h3>
      <button id="btn-close-modal" class="text-white/80 hover:text-white text-2xl leading-none">&times;</button>
    </div>
    
    <form id="form-report" class="p-6 space-y-4">
      <div class="space-y-2">
        <label class="block text-sm font-medium text-gray-700">Foto del objeto</label>
        <div class="relative border-2 border-dashed border-gray-300 rounded-lg p-4 text-center hover:bg-gray-50 transition-colors cursor-pointer group" id="dropzone">
          <input type="file" id="input-photo" name="foto" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" required>
          <div id="preview-container" class="hidden">
             <img id="preview-img" class="mx-auto h-32 object-contain rounded" />
             <span class="text-xs text-blue-600 block mt-2">Clic para cambiar</span>
          </div>
          <div id="upload-placeholder">
            <span class="text-2xl">📷</span>
            <p class="text-xs text-gray-500 mt-1 group-hover:text-blue-500">Toca para subir foto</p>
          </div>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
        <input type="text" name="desc_short" maxlength="30" placeholder="Ej. Llaves Honda..." class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-sm" required>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Categoría</label>
        <select name="category" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-sm bg-white" required>
          <option value="Otros">Selecciona una...</option>
          <option value="Electrónica">📱 Electrónica</option>
          <option value="Ropa">👕 Ropa</option>
          <option value="Documentos">📄 Documentos</option>
          <option value="Otros">📦 Otros</option>
        </select>
      </div>

      <input type="hidden" name="lat" id="input-lat">
      <input type="hidden" name="lon" id="input-lon">
      
      <button type="submit" id="btn-submit-report" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg shadow-md transition-transform active:scale-95">
        Publicar Reporte
      </button>
    </form>
  </div>
</div>

<div id="google-login-btn" class="hidden fixed top-4 right-4 z-[1000]"></div>

<script>
  import "../scripts/app.js";
</script>

<style>
  /* Estilos para forzar la barra de desplazamiento clásica y visible */
  .custom-scrollbar::-webkit-scrollbar {
    width: 10px; /* Un poco más ancha para que sea fácil de clickear */
  }
  
  .custom-scrollbar::-webkit-scrollbar-track {
    background: #f3f4f6; /* Gris muy claro para el fondo */
    border-left: 1px solid #e5e7eb;
  }
  
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: #9ca3af; /* Gris medio para la barra */
    border-radius: 6px;
    border: 2px solid #f3f4f6; /* Espacio alrededor para que se vea elegante */
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background-color: #6b7280; /* Gris más oscuro al pasar el mouse */
  }

  /* Para Firefox */
  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: #9ca3af #f3f4f6;
  }
</style>
</Layout>