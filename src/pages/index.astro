---
// src/pages/index.astro
import "../styles/global.css";
import DescargaApp from "../components/DescargaApp.astro";
---

<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LostNet - Iniciar Sesión y Descargar App</title>
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <style>
        /* Animación suave para la entrada */
        .fade-in-up {
            animation: fadeInUp 0.5s ease-out forwards;
            opacity: 0;
            transform: translateY(20px);
        }
        @keyframes fadeInUp {
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-[#F5F7FA] text-slate-800 min-h-screen font-sans flex flex-col justify-between antialiased">

    <!-- Barra de navegación superior -->
    <header class="w-full max-w-5xl mx-auto px-4 pt-6 pb-2 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
            <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-blue-700 rounded-xl flex items-center justify-center shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
                <img src="/favicon.jpg" alt="LostNet Logo" class="w-8 h-8 rounded-full object-cover border border-white" />
            </div>
            <span class="text-xl font-bold tracking-tight text-slate-800">Lost<span class="text-blue-600">Net</span></span>
        </a>

        <nav class="flex items-center gap-3">
            <a href="#descarga-app" class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-slate-600 hover:text-blue-600 bg-white/80 hover:bg-white px-3.5 py-2 rounded-xl shadow-sm border border-slate-200/60 transition-all">
                <svg class="w-4 h-4 fill-current text-blue-600" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-1.0001 0-.5515.4482-1.0001.9993-1.0001.5511 0 .9993.4486.9993 1.0001 0 .5515-.4482 1.0001-.9993 1.0001m-11.046 0c-.5511 0-.9993-.4486-.9993-1.0001 0-.5515.4482-1.0001.9993-1.0001.5511 0 .9993.4486.9993 1.0001 0 .5515-.4482 1.0001-.9993 1.0001m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1523-.5676.416.416 0 00-.5676.1523l-2.0223 3.503C15.5902 8.4126 13.8533 8 12 8s-3.5902.4126-5.1366 1.0504L4.8411 5.4475a.416.416 0 00-.5676-.1523.416.416 0 00-.1523.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.8h24c-.3432-4.1411-2.6889-7.6133-6.1185-9.4786"/>
                </svg>
                App Android
            </a>
        </nav>
    </header>

    <!-- Contenido principal -->
    <main class="flex-1 flex flex-col items-center justify-center p-4">
        <!-- Tarjeta de bienvenida e inicio de sesión -->
        <div class="bg-white p-8 sm:p-10 rounded-[32px] shadow-[0_20px_50px_rgba(0,0,0,0.05)] w-full max-w-[420px] text-center fade-in-up border border-white my-8">
            <div class="flex justify-center mb-8">
                <div class="w-20 h-20 bg-gradient-to-br from-blue-600 to-blue-700 rounded-2xl flex items-center justify-center shadow-lg shadow-blue-500/30">
                    <img src="/favicon.jpg"
                         alt="LostNet Logo"
                         class="w-16 h-16 rounded-full object-cover border-2 border-white shadow-md" />
                </div>
            </div>

            <h1 class="text-2xl font-bold text-slate-800 mb-3 tracking-tight">Bienvenido a LostNet</h1>
            <p class="text-slate-400 text-sm mb-8 leading-relaxed px-4">
                La plataforma inteligente para recuperar objetos perdidos.<br>
                Inicia sesión para continuar.
            </p>

            <div class="flex justify-center mb-6 h-[44px]">
                <div id="g_id_onload"
                     data-client_id="770683038158-7c53b3odm77q44vvt6uhqbkvt1au49pl.apps.googleusercontent.com"
                     data-callback="handleCredentialResponse"
                     data-auto_select="false"
                     data-itp_support="true">
                </div>
                
                <div class="g_id_signin"
                     data-type="standard"
                     data-shape="pill"
                     data-theme="outline"
                     data-text="continue_with"
                     data-size="large"
                     data-logo_alignment="left"
                     data-width="300"> </div>
            </div>

            <a href="#descarga-app" class="block w-full bg-blue-50 hover:bg-blue-100 text-blue-600 hover:text-blue-700 text-xs font-semibold py-4 rounded-xl transition-colors duration-200">
                Acceso unificado con la App Móvil ↓
            </a>
        </div>

        <!-- Sección de descarga de la app Android -->
        <section id="descarga-app" class="w-full max-w-4xl mx-auto px-2 sm:px-4 py-8 sm:py-12 scroll-mt-6" aria-label="Descarga de la app para Android">
            <DescargaApp />
        </section>
    </main>

    <!-- Footer -->
    <footer class="w-full border-t border-slate-200/60 bg-white/40 backdrop-blur-sm py-6 px-4 mt-auto">
        <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
            <p>© LostNet · Plataforma inteligente para recuperar objetos perdidos.</p>
            <div class="flex items-center gap-6">
                <a href="#descarga-app" class="hover:text-blue-600 transition-colors font-medium">App Android</a>
                <a href="/dashboard" class="hover:text-blue-600 transition-colors">Explorar mapa</a>
            </div>
        </div>
    </footer>

    <script is:inline>
        function decodeJwtResponse(token) {
            var base64Url = token.split('.')[1];
            var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            var jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
                return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join(''));
            return JSON.parse(jsonPayload);
        }

        window.handleCredentialResponse = (response) => {
            const data = decodeJwtResponse(response.credential);
            console.log("Usuario autenticado:", data);

            localStorage.setItem("user_email", data.email);
            localStorage.setItem("user_name", data.name);
            localStorage.setItem("user_photo", data.picture);
            localStorage.setItem("user_id", data.sub);

            window.location.href = "/dashboard";
        }
    </script>
</body>
</html>
