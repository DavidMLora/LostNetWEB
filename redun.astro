// --- NUEVO: VISOR DE IMÁGENES (LIGHTBOX) ---
const ImageModal = {
  init() {
    if (document.getElementById('image-modal')) return;
    
    // Crear el contenedor del modal
    const modal = document.createElement('div');
    modal.id = 'image-modal';
    // Estilos Tailwind: Fondo negro casi opaco, fijo, z-index alto
    modal.className = 'fixed inset-0 z-[9999] bg-black/90 hidden flex items-center justify-center p-4 cursor-pointer transition-opacity duration-300';
    modal.innerHTML = `
      <div class="relative max-w-4xl w-full h-full flex items-center justify-center">
        <img id="modal-img" src="" class="max-w-full max-h-[90vh] object-contain rounded-lg shadow-2xl drop-shadow-2xl" />
        <div class="absolute top-4 right-4 text-white bg-black/50 rounded-full w-10 h-10 flex items-center justify-center hover:bg-white/20 transition-colors">
            <span class="text-2xl font-bold pb-1">&times;</span>
        </div>
        <p class="absolute bottom-4 text-white/80 text-sm bg-black/50 px-3 py-1 rounded-full">Toca para cerrar</p>
      </div>
    `;
    
    // Cerrar al hacer click
    modal.onclick = () => {
      modal.classList.add('hidden');
    };
    
    document.body.appendChild(modal);
  },
  
  open(src) {
    const modal = document.getElementById('image-modal');
    const img = document.getElementById('modal-img');
    if (modal && img) {
      img.src = src;
      modal.classList.remove('hidden');
    }
  }
};

function decodeJwtResponse(token) {
  let base64Url = token.split('.')[1];
  let base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
  let jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
  }).join(''));
  return JSON.parse(jsonPayload);
}

class ApiService {
  constructor(baseUrl) {
    this.baseUrl = baseUrl;
  }

  async get(endpoint, params = {}) {
    const url = new URL(`${this.baseUrl}${endpoint}`);
    Object.keys(params).forEach(k => {
      if (params[k] !== null && params[k] !== undefined) url.searchParams.append(k, params[k]);
    });

    const res = await fetch(url);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    return await res.json();
  }

  fetchConfig() {
    return this.get(CONFIG.ENDPOINTS.CONFIG);
  }

  fetchReportes() {
    return this.get(CONFIG.ENDPOINTS.REPORTES);
  }

  fetchPuntosSeguros() {
    return this.get(CONFIG.ENDPOINTS.PUNTOS_SEGUROS);
  }

  fetchAlertas(email, coords = null) {
    if (!email) return Promise.resolve([]); 
    const params = { email };
    if (coords) {
      params.lat = coords.lat;
      params.lon = coords.lon;
    }
    return this.get(CONFIG.ENDPOINTS.ALERTAS, params);
  }

  fetchContacto(ownerId) {
    // Asumimos que el backend necesita el ID del usuario dueño del objeto
    return this.get(CONFIG.ENDPOINTS.CONTACTO, { user_id: ownerId });
  }

  resolveImageUrl(path) {
    if (!path) return null;
    return path.startsWith('http') ? path : `${this.baseUrl}${path}`;
  }
}

class MapController {
  constructor(elementId) {
    this.elementId = elementId;
    this.map = null;
    this.markers = L.layerGroup();
    // Colores iniciales (se actualizarán con /config)
    this.colors = { ...CONFIG.COLORS };
  }

  updateColors(serverColors) {
    if (serverColors) {
      this.colors = { ...this.colors, ...serverColors };
    }
  }

  init(coords, zoom) {
    if (this.map) return;
    const mapElement = document.getElementById(this.elementId);
    if (!mapElement) return;

    this.map = L.map(this.elementId).setView(coords, zoom);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© LostNet Contributors'
    }).addTo(this.map);
    this.markers.addTo(this.map);
  }

  clearMarkers() {
    if(this.markers) this.markers.clearLayers();
  }

  // --- NUEVO: MARCADOR DE PUNTO SEGURO (Escudo Verde) ---
  addSafePointMarker(point) {
    if (point.lat == null || point.lon == null) return;

    const popupContent = `
      <div class="min-w-[180px] font-sans text-center">
        <h3 class="font-bold text-green-700 text-base mb-1">🛡️ Punto Seguro</h3>
        <p class="font-semibold text-gray-800">${point.nombre}</p>
        <p class="text-xs text-gray-500 mt-1">${point.horario || "Horario desconocido"}</p>
        <span class="inline-block bg-green-100 text-green-800 text-xs px-2 py-0.5 rounded mt-1 border border-green-200">
          ${point.tipo || "Oficial"}
        </span>
      </div>
    `;

    const marker = L.marker([point.lat, point.lon], {
      icon: L.divIcon({
        className: "safe-point-marker",
        html: `<div style="
          width: 18px;
          height: 18px;
          background: ${this.colors.pin_seguro}; 
          border-radius: 4px;
          transform: rotate(45deg);
          border: 2px solid white;
          box-shadow: 0 0 5px rgba(0,255,0,0.5);
          display: flex;
          align-items: center;
          justify-content: center;
        "><div style="width:6px; height:6px; background:white; border-radius:50%;"></div></div>`
      })
    });

    marker.bindPopup(popupContent);
    marker.addTo(this.markers);
  }

  // --- ACTUALIZADO: MARCADOR DE REPORTE ---
  addReportMarker(report, isOwner, imageUrl, onContactClick) {
    if (report.lat == null || report.lon == null) return;
    
    // Usar colores dinámicos
    const color = isOwner ? this.colors.pin_propio : this.colors.pin_ajeno;
    
    // Mapeo de campos según tu nueva API
    const rawDesc = report.desc_short || report.descripcion || "Sin descripción";
    const safeDesc = rawDesc.replace(/</g, "&lt;");
    
    // Conversión de fecha (timestamp unix a legible)
    let fechaTexto = report.fecha || "Fecha desconocida";
    if (report.timestamp) {
        const fechaObj = new Date(report.timestamp * 1000);
        fechaTexto = fechaObj.toLocaleDateString() + ' ' + fechaObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    // Identificadores únicos para el botón y la imagen
    const uniqueId = report.id || Math.random().toString(36).substr(2, 9);
    const btnId = `btn-contact-${uniqueId}`;
    const imgId = `img-zoom-${uniqueId}`;

    const contactButtonHtml = !isOwner ? 
      `<button id="${btnId}" class="w-full mt-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold py-1.5 px-3 rounded transition-colors flex items-center justify-center gap-1">
         📞 Contactar Dueño
       </button>` : '';

    const popupContent = `
    <div class="min-w-[220px] font-sans">
      <div class="flex items-center justify-between mb-2">
         <h3 class="font-bold text-base" style="color:${color}">
            ${isOwner ? "Tu reporte" : "Objeto Perdido"}
         </h3>
         ${report.status === 'LOST' ? '<span class="text-[10px] bg-red-100 text-red-600 px-1.5 py-0.5 rounded border border-red-200 font-bold">PERDIDO</span>' : ''}
      </div>

      <p class="text-sm font-medium text-gray-800 mb-1">${safeDesc}</p>
      
      ${imageUrl ? `
        <div class="relative group cursor-zoom-in">
            <img id="${imgId}" src="${imageUrl}" class="w-full h-32 object-cover rounded border border-gray-100 mb-2 bg-gray-50 hover:brightness-90 transition-all" onerror="this.style.display='none'">
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
                <span class="bg-black/50 text-white text-xs px-2 py-1 rounded-full">🔍 Ver grande</span>
            </div>
        </div>
      ` : ""}
      
      <div class="flex items-center gap-1 text-xs text-gray-500 mb-2">
        <span>🕒 ${fechaTexto}</span>
      </div>

      ${contactButtonHtml}
    </div>`;

    const marker = L.marker([report.lat, report.lon], {
      icon: L.divIcon({
        className: "custom-marker",
        html: `<div style="width:16px;height:16px;background:${color};border-radius:50%;border:2px solid white;box-shadow:0 0 4px rgba(0,0,0,0.5);"></div>`
      })
    });

    marker.bindPopup(popupContent);
    marker.addTo(this.markers);

    // Event listeners para los elementos DENTRO del popup
    marker.on('popupopen', () => {
      // 1. Listener del Botón Contactar
      const btn = document.getElementById(btnId);
      if (btn) {
        btn.onclick = () => onContactClick(report.user_id);
      }

      // 2. Listener de la Imagen (Zoom)
      if (imageUrl) {
        const img = document.getElementById(imgId);
        if (img) {
            img.onclick = () => ImageModal.open(imageUrl);
        }
      }
    });
  }
}

// --- LÓGICA PRINCIPAL ---

const initApp = async () => {
  console.log('Iniciando LostNet Client...');
  
  // 0. Inicializar el Modal de Imágenes (Se inyecta en el body)
  ImageModal.init();

  const currentUser = SessionManager.getUser();
  const currentPath = window.location.pathname;
  
  if (currentPath.includes(CONFIG.ROUTES.DASHBOARD) && !currentUser) {
    window.location.href = CONFIG.ROUTES.LOGIN;
    return;
  }
  if (currentPath === CONFIG.ROUTES.LOGIN && currentUser) {
    window.location.href = CONFIG.ROUTES.DASHBOARD;
    return;
  }

  const api = new ApiService(CONFIG.API_BASE_URL);
  const mapController = new MapController('map');
  
  // Elementos DOM
  const btnRefresh = document.getElementById('btn-refresh');
  const btnGps = document.getElementById('btn-gps');
  const btnLogout = document.getElementById('btn-logout');
  const statReportes = document.getElementById('stat-reportes');
  const statSeguros = document.getElementById('stat-seguros');
  const statusIndicator = document.getElementById('status-indicator');
  const loginContainer = document.getElementById('google-login-btn');

  // Inicializar mapa
  mapController.init(CONFIG.DEFAULT_COORDS, CONFIG.DEFAULT_ZOOM);

  if (currentUser) {
    const headerTitle = document.querySelector('header h1');
    if(headerTitle) headerTitle.innerHTML = `LostNet <span class="text-blue-600 text-xs block">Hola, ${currentUser.given_name}</span>`;
  }

  // --- FUNCIÓN PARA UBICAR AL USUARIO (REUTILIZABLE) ---
  const locateUser = (silent = false) => {
    if (!navigator.geolocation) {
       if(!silent) alert('Geolocalización no soportada');
       return;
    }

    // Feedback visual en el botón solo si fue manual
    if (!silent && btnGps) btnGps.classList.add('opacity-50', 'cursor-wait');

    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const { latitude, longitude } = pos.coords;
        if (mapController.map) {
          mapController.map.flyTo([latitude, longitude], CONFIG.GPS_ZOOM);
          // Marcador de "Yo" (Radio + Punto)
          L.circleMarker([latitude, longitude], { radius: 10, color: '#3B82F6', fillOpacity: 0.2 }).addTo(mapController.map);
          L.circleMarker([latitude, longitude], { radius: 4, color: '#3B82F6', fillOpacity: 1 }).addTo(mapController.map);
        }
        if (!silent && btnGps) btnGps.classList.remove('opacity-50', 'cursor-wait');
      },
      (err) => {
        // En modo silencioso (carga de página), si falla no hacemos nada.
        console.warn("No se pudo obtener ubicación:", err.message);
        if (!silent) {
            alert('No pudimos ubicarte. Verifica los permisos.');
            if (btnGps) btnGps.classList.remove('opacity-50', 'cursor-wait');
        }
      },
      { enableHighAccuracy: true }
    );
  };

  // --- FUNCIÓN PARA MOSTRAR CONTACTO (Modal Simulado) ---
  const handleContactClick = async (ownerId) => {
    try {
      if(!ownerId) return alert("Error: No se puede identificar al usuario.");
      
      const contactInfo = await api.fetchContacto(ownerId);
      
      let msg = "El dueño prefiere ser contactado por:\n\n";
      if (contactInfo.whatsapp) msg += "✅ WhatsApp\n";
      if (contactInfo.llamada) msg += "✅ Llamada telefónica\n";
      if (contactInfo.mensaje) msg += `\nNota: "${contactInfo.mensaje}"`;
      
      alert(msg); // Aquí podrías hacer un modal HTML bonito en el futuro
    } catch (e) {
      console.error(e);
      alert("No se pudo obtener la información de contacto.");
    }
  };

  const loadData = async () => {
    if (!mapController.map) return;

    try {
      if (statusIndicator) statusIndicator.innerHTML = '<span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse"></span> Sincronizando...';
      
      mapController.clearMarkers();

      // 1. Obtener Configuración de Colores primero
      try {
        const config = await api.fetchConfig();
        if (config && config.colores_mapa) {
          mapController.updateColors(config.colores_mapa);
        }
      } catch (e) {
        console.warn("Usando colores por defecto (offline o error config)");
      }

      // 2. Obtener Datos Principales
      const [reportesResult, segurosResult, alertasResult] = await Promise.allSettled([
        api.fetchReportes(),
        api.fetchPuntosSeguros(),
        currentUser ? api.fetchAlertas(currentUser.email) : Promise.resolve([])
      ]);

      const reportes = reportesResult.status === 'fulfilled' ? reportesResult.value : [];
      const seguros = segurosResult.status === 'fulfilled' ? segurosResult.value : [];
      const alertas = alertasResult.status === 'fulfilled' ? alertasResult.value : [];

      console.log("Reportes cargados:", reportes);

      // 3. Pintar Reportes
      if (Array.isArray(reportes)) {
        reportes.forEach(r => {
          // Comparación robusta de ID (Email vs ID)
          const isOwner = currentUser && (r.user_id === currentUser.email || r.user_id === currentUser.sub);
          const img = api.resolveImageUrl(r.photo_url || r.imagen_url); 
          
          mapController.addReportMarker(r, isOwner, img, handleContactClick);
        });
        if (statReportes) statReportes.textContent = reportes.length;
      }

      // 4. Pintar Puntos Seguros (NUEVO)
      if (Array.isArray(seguros)) {
        seguros.forEach(point => {
           mapController.addSafePointMarker(point);
        });
        if (statSeguros) statSeguros.textContent = seguros.length;
      }

      // 5. Panel de Alertas
      const alertsContainer = document.getElementById('alerts-container');
      if (alertsContainer) {
        if (!alertas.length) {
          alertsContainer.innerHTML = '<p class="text-xs text-gray-400 italic text-center py-4">Todo tranquilo por aquí</p>';
        } else {
          alertsContainer.innerHTML = alertas.map(a => `
            <div class="bg-red-50 p-3 rounded-lg border-l-4 border-red-500 shadow-sm mb-2">
              <div class="flex justify-between items-start">
                 <strong class="text-red-800 text-xs font-bold uppercase tracking-wide">🚨 Alerta Cercana</strong>
                 <span class="text-[10px] text-red-400">${new Date(a.timestamp * 1000).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>
              </div>
              <p class="text-gray-700 text-sm mt-1 leading-snug">${a.message}</p>
            </div>
          `).join('');
        }
      }

      if (statusIndicator) statusIndicator.innerHTML = '<span class="w-2 h-2 rounded-full bg-green-500"></span> En línea';

    } catch (error) {
      console.error("Error crítico cargando datos:", error);
      if (statusIndicator) statusIndicator.innerHTML = '<span class="w-2 h-2 rounded-full bg-red-500"></span> Error de Red';
    }
  };

  // --- GOOGLE AUTH ---
  const handleCredentialResponse = (response) => {
    const responsePayload = decodeJwtResponse(response.credential);
    SessionManager.saveUser(responsePayload);
    window.location.href = CONFIG.ROUTES.DASHBOARD;
  };

  if (window.google && loginContainer) {
    google.accounts.id.initialize({
      client_id: CONFIG.GOOGLE_CLIENT_ID,
      callback: handleCredentialResponse
    });
    google.accounts.id.renderButton(loginContainer, { theme: "outline", size: "large", width: "250", shape: "pill" });
  }

  // Listeners
  if (btnRefresh) btnRefresh.addEventListener('click', loadData);
  if (btnLogout) btnLogout.addEventListener('click', SessionManager.logout);
  if (btnGps) {
    // Al hacer click, pasamos 'false' (NO silencioso) para mostrar errores si fallan
    btnGps.addEventListener('click', () => locateUser(false));
  }

  // Intentar ubicar automáticamente al cargar (Silencioso: true)
  if (mapController.map) {
    // Primero cargamos los datos
    await loadData();
    // Luego intentamos ubicar al usuario suavemente
    locateUser(true);
  }
};

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initApp);
} else {
  initApp();
} -->